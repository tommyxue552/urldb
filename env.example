# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=url_db

# 数据库迁移配置
# 是否执行数据库迁移（true=执行迁移，false=跳过迁移）
MIGRATE=true

# 服务器配置
PORT=8080
GIN_MODE=release

# JWT signing and verification. Generate at least 32 random bytes, e.g.
# openssl rand -base64 48. JWT_PREVIOUS_SECRET is optional and is used only
# during a bounded rotation window to verify tokens issued by the former key.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_PREVIOUS_SECRET=

# Provider credentials are encrypted with AES-256-GCM at the repository boundary.
# Inject both values from the deployment secret manager/KMS; each must decode to
# exactly 32 bytes (for example: openssl rand -base64 32).
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-secret
CREDENTIAL_FINGERPRINT_KEY=replace-with-a-different-base64-encoded-32-byte-secret

# 时区配置
TIMEZONE=Asia/Shanghai

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5MB 

# 日志配置
LOG_LEVEL=INFO          # 日志级别 (DEBUG, INFO, WARN, ERROR, FATAL)
DEBUG=false             # 调试模式开关
STRUCTURED_LOG=false

# 授权转存 provider 合规闸门（默认留空，即拒绝所有自动转存）。
# 仅在已取得对应网盘官方 API 或书面获准集成资格、并完成合规审查后才添加 provider。
# 每个列入的 provider 都必须配置证据引用和最大公开分享保留天数；资源级授权仍需
# 单独登记其证据与 retention_until。示例 provider 名称：baidu、quark、alipan、uc、xunlei。
AUTHORIZED_TRANSFER_APPROVED_PROVIDERS=
# AUTHORIZED_TRANSFER_PROVIDER_BAIDU_APPROVAL_REF=https://official.example/agreement-or-api-doc
# AUTHORIZED_TRANSFER_PROVIDER_BAIDU_MAX_SHARE_RETENTION_DAYS=30

# ===========================================
# 插件系统配置
# ===========================================

# 是否启用插件系统
PLUGIN_ENABLED=true

# 是否启用插件热重载（文件变化时自动重载）
PLUGIN_HOT_RELOAD=true

# 插件目录配置
PLUGIN_HOOKS_DIR=./hooks
PLUGIN_MIGRATIONS_DIR=./migrations
PLUGIN_TYPES_DIR=./pb_data

# JavaScript 虚拟机配置
PLUGIN_VM_POOL_SIZE=10

# 插件调试模式
PLUGIN_DEBUG=false

# 插件性能配置
PLUGIN_MAX_MEMORY_MB=512
PLUGIN_MAX_EXECUTION_TIME_SEC=30
PLUGIN_MAX_CONCURRENT_JOBS=5

# 插件安全配置
PLUGIN_ENABLE_SANDBOX=true
PLUGIN_ALLOWED_FILE_SIZE_MB=10
PLUGIN_ENABLE_NETWORK_ACCESS=false

# 插件日志配置
PLUGIN_LOG_LEVEL=info
PLUGIN_ENABLE_PERFORMANCE_LOGGING=false
PLUGIN_LOG_RETENTION_DAYS=7

# 插件通知配置
PLUGIN_NOTIFICATION_EMAIL_ENABLED=false
PLUGIN_NOTIFICATION_EMAIL_SMTP_HOST=
PLUGIN_NOTIFICATION_EMAIL_SMTP_PORT=587
PLUGIN_NOTIFICATION_EMAIL_USERNAME=
PLUGIN_NOTIFICATION_EMAIL_PASSWORD=
PLUGIN_NOTIFICATION_EMAIL_FROM=

# 插件Webhook配置
PLUGIN_WEBHOOK_ENABLED=false
PLUGIN_WEBHOOK_URL=
PLUGIN_WEBHOOK_SECRET=
PLUGIN_WEBHOOK_TIMEOUT_SEC=10

# 插件定时任务配置
PLUGIN_CRON_ENABLED=true
PLUGIN_CRON_MAX_CONCURRENT_JOBS=3
PLUGIN_CRON_TIMEZONE=Asia/Shanghai

# 插件API配置
PLUGIN_API_RATE_LIMIT_ENABLED=true
PLUGIN_API_RATE_LIMIT_REQUESTS_PER_MINUTE=100
PLUGIN_API_CORS_ENABLED=true
PLUGIN_API_CORS_ALLOWED_ORIGINS=*
